# Copy this file to .env and set strong, random values. .env is gitignored — never commit it.
# Generate a value with:   openssl rand -hex 24
#
# docker compose refuses to start while these are empty.

# Password of the Elasticsearch 'elastic' user — used by the app, the host-side scripts
# (indexer, cache warm-up) and to log in to Kibana in the browser.
ELASTIC_PASSWORD=

# Password that Kibana itself uses to connect to Elasticsearch (built-in 'kibana_system'
# user; set automatically by the one-shot 'setup' service).
KIBANA_PASSWORD=

# Password for Redis (per-session chat history).
REDIS_PASSWORD=
